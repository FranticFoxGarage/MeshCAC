# MeshCAC - USB unlock udev rules
# Install to: /etc/udev/rules.d/99-meshcac.rules
#
# Find your device values:
#   Vendor/Product: lsusb
#   Serial:         udevadm info -a -n /dev/ttyUSB0 | grep serial
#
# After editing, reload with: sudo udevadm control --reload-rules

# Device plugged in
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="XXXX", ATTR{idProduct}=="XXXX", ATTRS{serial}=="XXXX", RUN+="/usr/local/bin/usb-unlock.sh connect"

# Device removed
ACTION=="remove", SUBSYSTEM=="usb", ENV{ID_VENDOR_ID}=="XXXX", ENV{ID_MODEL_ID}=="XXXX", ENV{ID_SERIAL_SHORT}=="XXXX", RUN+="/usr/local/bin/usb-unlock.sh disconnect"
